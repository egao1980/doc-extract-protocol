(in-package #:doc-extract-protocol)

(defun normalize-ws (s)
  (let ((out (make-array (length s) :element-type 'character :fill-pointer 0)))
    (loop with space = nil
          for i from 0 below (length s)
          for c = (char s i)
          do (if (member c '(#\Space #\Tab #\Newline #\Return #\Page))
                 (setf space t)
                 (progn
                   (when (and space (plusp (fill-pointer out)))
                     (vector-push-extend #\Space out))
                   (setf space nil)
                   (vector-push-extend c out))))
    (coerce out 'string)))

(defun %text-equivalent-p (a b)
  (string= (normalize-ws (document-text a :layer :body))
           (normalize-ws (document-text b :layer :body))))

(defun %block-kind (block)
  (cond
    ((typep block 'text-block)
     (list :text (text-block-kind block)))
    ((typep block 'list-block)
     (list :list (and (list-block-ordered-p block) t)))
    ((typep block 'table-block)
     (list :table (table-block-rows block) (table-block-cols block)))
    ((typep block 'section)
     (list :section (section-level block)))
    (t (list (block-node-type block)))))

(defun %structure-blocks-p (as bs)
  (and (= (length as) (length bs))
       (every (lambda (a b)
                (and (equal (%block-kind a) (%block-kind b))
                     (%structure-blocks-p (block-children a)
                                          (block-children b))
                     (if (and (typep a 'table-block) (typep b 'table-block))
                         (let ((ca (or (table-block-cells a) nil))
                               (cb (or (table-block-cells b) nil)))
                           (and (= (length ca) (length cb))
                                (every (lambda (x y)
                                         (and (= (table-cell-row x)
                                                 (table-cell-row y))
                                              (= (table-cell-col x)
                                                 (table-cell-col y))
                                              (= (or (table-cell-row-span x) 1)
                                                 (or (table-cell-row-span y) 1))
                                              (= (or (table-cell-col-span x) 1)
                                                 (or (table-cell-col-span y) 1))))
                                       ca cb)))
                         t)))
              as bs)))

(defun %attrs-plist= (a b)
  (let ((a (or a nil))
        (b (or b nil)))
    (and (listp a) (listp b)
         (evenp (length a)) (evenp (length b))
         (loop for (k v) on a by #'cddr
               always (equal v (getf b k)))
         (loop for (k v) on b by #'cddr
               always (equal v (getf a k))))))

(defun %slot= (a b slot)
  (let ((ba (and a (slot-exists-p a slot) (slot-boundp a slot)))
        (bb (and b (slot-exists-p b slot) (slot-boundp b slot))))
    (cond
      ((and ba bb) (equal (slot-value a slot) (slot-value b slot)))
      ((not (or ba bb)) t)
      (t nil))))

(defun %default-coord-p (cs)
  (or (null cs)
      (and (eq (or (and (slot-boundp cs 'origin) (coord-system-origin cs))
                   :top-left)
               :top-left)
           (eq (or (and (slot-boundp cs 'units) (coord-system-units cs))
                   :pixels)
               :pixels)
           (not (%slot-bound-value cs 'layout-width))
           (not (%slot-bound-value cs 'layout-height)))))

(defun %slot-bound-value (object slot)
  (and object (slot-exists-p object slot) (slot-boundp object slot)
       (slot-value object slot)))

(defun %coord= (a b)
  (or (and (%default-coord-p a) (%default-coord-p b))
      (and a b
           (eq (or (and (slot-boundp a 'origin) (coord-system-origin a)) :top-left)
               (or (and (slot-boundp b 'origin) (coord-system-origin b)) :top-left))
           (eq (or (and (slot-boundp a 'units) (coord-system-units a)) :pixels)
               (or (and (slot-boundp b 'units) (coord-system-units b)) :pixels))
           (%slot= a b 'layout-width)
           (%slot= a b 'layout-height))))

(defun %prov= (a b)
  (and (= (length a) (length b))
       (every (lambda (x y)
                (and (%slot= x y 'page)
                     (%slot= x y 'bbox)
                     (%slot= x y 'charspan)
                     (%coord= (and (slot-boundp x 'coord-system)
                                   (provenance-entry-coord-system x))
                              (and (slot-boundp y 'coord-system)
                                   (provenance-entry-coord-system y)))))
              a b)))

(defun %plain-text= (a b)
  (string= (or (block-plain-text a) "")
           (or (block-plain-text b) "")))

(defun %strict-blocks-p (as bs)
  (and (= (length as) (length bs))
       (every (lambda (a b)
                (and (equal (%block-kind a) (%block-kind b))
                     (%slot= a b 'id)
                     (eq (or (and (slot-boundp a 'layer) (block-layer a)) :body)
                         (or (and (slot-boundp b 'layer) (block-layer b)) :body))
                     (%attrs-plist= (and (slot-boundp a 'attrs) (block-attrs a))
                                    (and (slot-boundp b 'attrs) (block-attrs b)))
                     (%prov= (and (slot-boundp a 'provenance) (block-provenance a))
                             (and (slot-boundp b 'provenance) (block-provenance b)))
                     (%plain-text= a b)
                     (%strict-blocks-p (block-children a)
                                       (block-children b))))
              as bs)))

(defun document-equivalent-p (a b &key (level :structure))
  "Fidelity tiers: :text (body plain text), :structure (shape/order),
   :strict (structure + ids + provenance + attrs + block text)."
  (check-type a extracted-document)
  (check-type b extracted-document)
  (ecase level
    (:text (%text-equivalent-p a b))
    (:structure
     (%structure-blocks-p (extracted-document-blocks a)
                          (extracted-document-blocks b)))
    (:strict
     (and (%structure-blocks-p (extracted-document-blocks a)
                               (extracted-document-blocks b))
          (%strict-blocks-p (extracted-document-blocks a)
                            (extracted-document-blocks b))))))
